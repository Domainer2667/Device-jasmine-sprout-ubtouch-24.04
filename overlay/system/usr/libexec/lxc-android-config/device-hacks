#!/bin/sh

# Set permissions for DT2W (Double Tap To Wake)
if [ -e /proc/nvt_wake_gesture ]; then
    chmod 0660 /proc/nvt_wake_gesture
    chown system:system /proc/nvt_wake_gesture
fi

# Enable Wi-Fi display
setprop ubuntu.widi.supported 1

# BMS fake battery capacity if specified
fake_batt_capacity=$(getprop persist.vendor.bms.fake_batt_capacity)
if [ -n "$fake_batt_capacity" ]; then
    echo "$fake_batt_capacity" > /sys/class/power_supply/battery/capacity
fi

# Set fpsensor property and permissions
fpsensor=$(getprop ro.boot.fpsensor)
if [ -n "$fpsensor" ]; then
    setprop vendor.boot.fpsensor "$fpsensor"
fi

if [ -e /dev/goodix_fp ]; then
    chmod 0666 /dev/goodix_fp
    chown system:system /dev/goodix_fp
fi
if [ -e /dev/fpc1020 ]; then
    chmod 0666 /dev/fpc1020
    chown system:system /dev/fpc1020
fi


# Ensure Goodix fingerprint firmware is available in /system/etc/firmware
if [ -f /vendor/firmware/goodixfp.mdt ] || [ -f /android/vendor/firmware/goodixfp.mdt ]; then
    mkdir -p /run/system-etc-overlay/upper /run/system-etc-overlay/work
    mount -t overlay overlay -o lowerdir=/android/system/etc,upperdir=/run/system-etc-overlay/upper,workdir=/run/system-etc-overlay/work /android/system/etc 2>/dev/null || true
    mkdir -p /android/system/etc/firmware
    src_dir="/vendor/firmware"
    [ ! -f "$src_dir/goodixfp.mdt" ] && src_dir="/android/vendor/firmware"
    cp -n "$src_dir"/goodixfp.* /android/system/etc/firmware/ 2>/dev/null || true
    chmod 0644 /android/system/etc/firmware/* 2>/dev/null || true
fi

# Mount persist partition where expected by Android HALs and daemons
if [ -d /mnt/vendor/persist ] && [ ! -e /persist/alarm ]; then
    mount --bind /mnt/vendor/persist /persist 2>/dev/null || true
fi
if [ -d /mnt/vendor/persist ] && [ -d /var/lib/lxc/android/rootfs/persist ]; then
    mount --bind /mnt/vendor/persist /var/lib/lxc/android/rootfs/persist 2>/dev/null || true
fi

# Prevent kernel panic on subsystem crash (set SSR to RELATED)
for s in /sys/bus/msm_subsys/devices/subsys*/restart_level; do
    [ -f "$s" ] && echo RELATED > "$s"
done

# Prevent kernel reboot on oops / soft lockups
echo 0 > /proc/sys/kernel/panic_on_oops 2>/dev/null || true
echo 0 > /proc/sys/kernel/panic 2>/dev/null || true

# Mute UART serial console flood (prevents MSM watchdog bite on binder printk burst)
echo "1 1 1 7" > /proc/sys/kernel/printk 2>/dev/null || true

# Fix cgroup directory permissions for systemd user services (app launching)
chmod 0755 /sys/fs/cgroup 2>/dev/null || true

# Configure Waydroid properties for rock-solid stability on Ubuntu Touch
if [ -d /var/lib/waydroid ]; then
    # Helper function for idempotent prop setting using sed
    waydroid_set_prop() {
        local prop="$1"
        local val="$2"
        local prop_file="/var/lib/waydroid/waydroid.prop"
        if grep -q "^${prop}=" "$prop_file"; then
            sed -i "s/^${prop}=.*/${prop}=${val}/g" "$prop_file"
        else
            echo "${prop}=${val}" >> "$prop_file"
        fi
    }

    waydroid_set_prop "ro.hardware.egl" "adreno"
    waydroid_set_prop "ro.opengles.version" "196610"
    waydroid_set_prop "ro.hardware.gralloc" "default"
    waydroid_set_prop "persist.waydroid.multi_windows" "false"
    waydroid_set_prop "dalvik.vm.dex2oat-filter" "verify"
    waydroid_set_prop "ro.nnapi.disabled" "1"
    waydroid_set_prop "ro.sys.fw.bg_apps_limit" "16"
    waydroid_set_prop "dalvik.vm.heapgrowthlimit" "256m"
    waydroid_set_prop "dalvik.vm.heapsize" "512m"

    # Ensure waydroid.cfg defaults match adreno & default gralloc
    if [ -f /var/lib/waydroid/waydroid.cfg ]; then
        sed -i 's/ro.hardware.gralloc = .*/ro.hardware.gralloc = default/g' /var/lib/waydroid/waydroid.cfg 2>/dev/null || true
        sed -i 's/ro.hardware.egl = .*/ro.hardware.egl = adreno/g' /var/lib/waydroid/waydroid.cfg 2>/dev/null || true
        sed -i 's/ro.opengles.version = .*/ro.opengles.version = 196610/g' /var/lib/waydroid/waydroid.cfg 2>/dev/null || true
    fi

    # Tune CPU governor for performance
    for cpu_gov in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
        [ -f "$cpu_gov" ] && echo "schedutil" > "$cpu_gov" 2>/dev/null || true
    done
fi

# Patch waydroid template config to prevent broken product bind mount
if [ -f /usr/lib/waydroid/data/configs/config_base ]; then
    sed -i '/product none bind/d' /usr/lib/waydroid/data/configs/config_base 2>/dev/null || true
    sed -i '/lxc.cap.drop/d' /usr/lib/waydroid/data/configs/config_base 2>/dev/null || true
    sed -i '/lxc.cgroup2.cpuset.cpus/d' /usr/lib/waydroid/data/configs/config_base 2>/dev/null || true
fi

# Clean up Waydroid LXC config
if [ -f /var/lib/waydroid/lxc/waydroid/config ]; then
    sed -i '/product none bind/d' /var/lib/waydroid/lxc/waydroid/config 2>/dev/null || true
    sed -i '/lxc.cap.drop/d' /var/lib/waydroid/lxc/waydroid/config 2>/dev/null || true
    sed -i '/lxc.cgroup2.cpuset.cpus/d' /var/lib/waydroid/lxc/waydroid/config 2>/dev/null || true
fi
