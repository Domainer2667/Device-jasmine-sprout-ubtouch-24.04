[Unit]
Description=Goodix Fingerprint Firmware and HAL Setup
Before=biometryd.service
After=lxc-android-config.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c "chmod 0666 /dev/goodix_fp 2>/dev/null || true; chown system:system /dev/goodix_fp 2>/dev/null || true"
RemainAfterExit=true

[Install]
WantedBy=multi-user.target
