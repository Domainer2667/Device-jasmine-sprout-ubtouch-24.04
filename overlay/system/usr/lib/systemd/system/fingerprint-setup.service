[Unit]
Description=Goodix Fingerprint Firmware and HAL Setup
Before=biometryd.service
After=lxc-android-config.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c "if [ -d /android/vendor/firmware ] && [ -d /var/lib/lxc/android/rootfs/vendor/firmware_mnt/image ]; then mount --bind /android/vendor/firmware /var/lib/lxc/android/rootfs/vendor/firmware_mnt/image 2>/dev/null || true; fi; chmod 0666 /dev/goodix_fp 2>/dev/null || true; chown 1000:1000 /dev/goodix_fp 2>/dev/null || true; lxc-attach -n android -- /system/bin/setprop ctl.restart vendor.fps_hal 2>/dev/null || true"
RemainAfterExit=true

[Install]
WantedBy=multi-user.target
