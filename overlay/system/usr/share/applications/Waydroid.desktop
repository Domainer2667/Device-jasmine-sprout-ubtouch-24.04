[Desktop Entry]
Type=Application
Name=Waydroid
GenericName=Android Container
Comment=Run Android apps in a containerized environment.
Exec=waydroid show-full-ui
Icon=waydroid
Categories=X-WayDroid-App;Utility;
Actions=stop;initialize;
X-Purism-FormFactor=Workstation;Mobile;
X-Lomiri-Supported-Orientations=portrait
NoDisplay=false

[Desktop Action stop]
Name=Stop Waydroid
Exec=waydroid session stop
Icon=waydroid

[Desktop Action initialize]
Name=Initialize Waydroid
Exec=waydroid init --client
